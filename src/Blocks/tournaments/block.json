{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rockaden/tournaments",
  "version": "0.1.0",
  "title": "Tournaments",
  "category": "widgets",
  "icon": "awards",
  "description": "Displays an overview grid of tournaments.",
  "textdomain": "rockaden-chess",
  "attributes": {
    "layout": {
      "type": "string",
      "default": "cards",
      "enum": [
        "cards",
        "list"
      ]
    },
    "showStatus": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showDates": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showSsfBadge": {
      "type": "boolean",
      "default": true
    },
    "showLocation": {
      "type": "boolean",
      "default": false
    },
    "showTimeControl": {
      "type": "boolean",
      "default": false
    },
    "showParticipantCount": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:../../../build/blocks/tournaments/index.js",
  "viewScript": "file:../../../build/blocks/tournaments/view.js",
  "viewStyle": "file:../../../build/blocks/tournaments/view.css",
  "render": "file:./render.php"
}
