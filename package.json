{
  "name": "rockaden-chess",
  "private": true,
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "wp-scripts build",
    "dev": "wp-scripts start",
    "typecheck": "tsc --noEmit",
    "lint": "wp-scripts lint-js",
    "lint:js": "wp-scripts lint-js",
    "lint:php": "composer lint:php",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm run lint:php && pnpm run i18n:check && pnpm build",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.2.0",
    "@lichess-org/pgn-viewer": "2.6.4",
    "@msvens/schack-se-sdk": "github:msvens/schack-se-sdk#v0.17.0",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/blocks": "^13.0.0",
    "@wordpress/components": "^29.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "chessops": "^0.15.1",
    "flatpickr": "^4.6.13"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wordpress/browserslist-config": "^6.0.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript": "^5.7.0"
  }
}
